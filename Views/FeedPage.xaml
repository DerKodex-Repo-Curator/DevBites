<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DevBites.Views.FeedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DevBites.Views.Controls"
    xmlns:viewmodels="clr-namespace:DevBites.ViewModels"
    x:DataType="viewmodels:FeedViewModel"
    BackgroundColor="#0A0E1A"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  ── Header ──────────────────────────────────────────────────  -->
        <controls:FeedHeaderView Grid.Row="0" />

        <!--  Header bottom divider  -->
        <BoxView
            Grid.Row="0"
            BackgroundColor="#1F2937"
            HeightRequest="1"
            VerticalOptions="End" />

        <!--  ── Feed ─────────────────────────────────────────────────────  -->
        <CollectionView
            Grid.Row="1"
            BackgroundColor="Transparent"
            ItemsSource="{Binding Reels}"
            RemainingItemsThreshold="2"
            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <BoxView BackgroundColor="Transparent" HeightRequest="8" />
            </CollectionView.Header>

            <CollectionView.Footer>
                <BoxView BackgroundColor="Transparent" HeightRequest="12" />
            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <controls:ReelCardView />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--  ── Bottom status bar (loading / error) ───────────────────────  -->
        <Grid
            Grid.Row="2"
            MinimumHeightRequest="52"
            BackgroundColor="#0A0E1A"
            Padding="16,8,16,20">
            <ActivityIndicator
                HorizontalOptions="Center"
                Color="#8B5CF6"
                HeightRequest="28"
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="Center"
                WidthRequest="28" />
            <Label
                FontSize="13"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding HasError}"
                Text="{Binding ErrorMessage}"
                TextColor="#EF4444"
                VerticalOptions="Center" />
        </Grid>

        <!--  ── Initial loading overlay (covers everything on first load) ──  -->
        <Grid
            Grid.RowSpan="3"
            BackgroundColor="#0A0E1A"
            IsVisible="{Binding IsInitialLoading}">
            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="20"
                VerticalOptions="Center">
                <ActivityIndicator
                    HorizontalOptions="Center"
                    Color="#8B5CF6"
                    HeightRequest="52"
                    IsRunning="True"
                    WidthRequest="52" />
                <Label
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="Fetching DevBites…"
                    TextColor="#9CA3AF" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
